+package app
+
+import (
+	"context"
+	"encoding/json"
+	"strings"
+	"testing"
+
+	"github.com/eugenioenko/ttt/internal/plugin"
+	lua "github.com/yuin/gopher-lua"
+)
+
+func automationTestPlugin(t *testing.T, a *App) *plugin.Plugin {
+	t.Helper()
+	p := &plugin.Plugin{Enabled: true, State: lua.NewState()}
+	t.Cleanup(func() { p.State.Close() })
+	p.Editor = NewPluginEditorAPI(a)
+	return p
+}
+
+func TestPluginAutomationAcknowledgesPasteAndUndo(t *testing.T) {
+	a := newListenTestApp(t)
+	p := automationTestPlugin(t, a)
+	if _, err := a.runPluginAutomation(context.Background(), p, "paste", "héllo\n世界"); err != nil {
+		t.Fatal(err)
+	}
+	raw, err := a.runPluginAutomation(context.Background(), p, "buffer", "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var result struct {
+		Text string `json:"text"`
+	}
+	if err := json.Unmarshal(raw, &result); err != nil {
+		t.Fatal(err)
+	}
+	if result.Text != "héllo\n世界" {
+		t.Fatalf("buffer=%q", result.Text)
+	}
+	if _, err := a.runPluginAutomation(context.Background(), p, "command", "editor.undo"); err != nil {
+		t.Fatal(err)
+	}
+	raw, err = a.runPluginAutomation(context.Background(), p, "buffer", "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	_ = json.Unmarshal(raw, &result)
+	if result.Text != "" {
+		t.Fatalf("undo left %q", result.Text)
+	}
+}
+
+func TestPluginAutomationCannotActDuringApproval(t *testing.T) {
+	a := newListenTestApp(t)
+	p := automationTestPlugin(t, a)
+	if err := runExecMain(a, func() error { a.PendingPluginApprovals = []*plugin.Plugin{{Name: "pending"}}; return nil }); err != nil {
+		t.Fatal(err)
+	}
+	for _, action := range []string{"type", "paste", "command", "rclick", "hover"} {
+		args := "hello"
+		if action == "rclick" || action == "hover" {
+			args = "2 2"
+		}
+		if _, err := a.runPluginAutomation(context.Background(), p, action, args); err == nil || !strings.Contains(err.Error(), "permissions are pending") {
+			t.Fatalf("%s: %v", action, err)
+		}
+	}
+}
diff --git a/internal/plugin/lua_automation.go b/internal/plugin/lua_automation.go
new file mode 100644
index 00000000..12e4c129
--- /dev/null
+++ b/internal/plugin/lua_automation.go
@@ -0,0 +1,70 @@
+package plugin
+
+import (
+	"context"
+	"encoding/json"
+	"time"
+
+	lua "github.com/yuin/gopher-lua"
+)
+
+func setupAutomationModule(L *lua.LState, p *Plugin) {
+	L.PreloadModule("ttt.automation", func(L *lua.LState) int {
+		mod := L.NewTable()
+		L.SetField(mod, "run", L.NewFunction(func(L *lua.LState) int {
+			action, args, callback := L.CheckString(1), L.CheckString(2), L.CheckFunction(3)
+			for _, permission := range automationPermissions(action) {
+				if err := p.Granted.Check(permission); err != nil {
+					L.RaiseError("%s", err.Error())
+					return 0
+				}
+			}
+			run := p.RunAutomation
+			if run == nil {
+				L.RaiseError("automation API not available")
+				return 0
+			}
+			ctx, cancel := context.WithTimeout(context.Background(), 35*time.Second)
+			id := p.registerTimer(cancel)
+			go func() {
+				defer cancel()
+				result, err := run(ctx, action, args)
+				p.SafePostAsync(&PluginAsyncResult{Plugin: p, Callback: func() {
+					p.ClearTimer(id)
+					if p.State == nil {
+						return
+					}
+					if err != nil {
+						_ = p.CallLuaFunc(callback, lua.LNil, lua.LString(err.Error()))
+						return
+					}
+					var value any
+					_ = json.Unmarshal(result, &value)
+					_ = p.CallLuaFunc(callback, goToLua(p.State, value), lua.LNil)
+				}})
+			}()
+			L.Push(L.NewFunction(func(L *lua.LState) int { cancel(); return 0 }))
+			return 1
+		}))
+		L.Push(mod)
+		return 1
+	})
+}
+
+// automationPermissions lists what an action needs. The debug dump includes
+// buffer text and terminal history, so it needs their read permissions too.
+func automationPermissions(action string) []string {
+	switch action {
+	case "session", "buffer":
+		return []string{"editor.read"}
+	case "screenshot", "wait-for":
+		return []string{"screen.read"}
+	case "debug":
+		return []string{"screen.read", "editor.read", "terminal.read"}
+	case "commands", "exec", "command", "panel", "copy", "open":
+		return []string{"commands"}
+	case "clipboard":
+		return []string{"clipboard.read"}
+	}
+	return []string{"input"}
+}
